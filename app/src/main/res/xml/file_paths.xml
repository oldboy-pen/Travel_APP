<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 分享路径：GPX 导出目录 -->
<paths>
    <cache-path name="gpx" path="gpx/" />
    <!-- 3D 运动视频导出目录（cacheDir，分享后即可清理） -->
    <cache-path name="track_video" path="track_video/" />
    <!-- 相机拍照输出目录（filesDir，持久保存避免被系统清理） -->
    <files-path name="camera" path="camera/" />
    <!-- 相机录像输出目录 -->
    <files-path name="video" path="video/" />
    <!-- 应用内录音输出目录 -->
    <files-path name="voice" path="voice/" />
</paths>
