<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 基础权限 ============ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ============ 定位权限 ============ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 语音标记需要 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 息屏后台持续记录轨迹需要（用户需在设置中选"始终允许"） -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 10+ 硬件计步传感器需要（确认"确实在走"，防徒步小位移被降噪误杀） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 扫码添加图源需要 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ============ 前台服务（轨迹记录保活，类似两步路） ============ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ 通知运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台保活：息屏后 CPU 不深睡（服务内持有 PARTIAL_WAKE_LOCK） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 后台保活：请求加入"电池优化"白名单（弹系统对话框用） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 查询高德地图App是否安装（用于一键导航拉起） -->
    <queries>
        <package android:name="com.autonavi.minimap" />
    </queries>

    <!-- Android 9+ 默认禁止明文 HTTP；这里临时放行，方便连本机验证服务器（正式包应删掉） -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyFirstApp"
        android:usesCleartextTraffic="true">

        <!-- ★ 地图厂商 Key：替换成你自己申请的！三处都必须改，否则对应图源白屏/水印「鉴权失败」 -->
        <!-- 高德开放平台 https://console.amap.com/dev/key/app -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="8844b9b23ba616c86e95e7d45b1d31a8" />
        <!-- 腾讯位置服务 https://lbs.qq.com/dev/console/application/mine -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="YOUR_TENCENT_MAP_KEY" />
        <!-- 百度地图开放平台 https://lbsyun.baidu.com/apiconsole/key#/home -->
        <meta-data
            android:name="com.baidu.lbsapi.API_KEY"
            android:value="YOUR_BAIDU_MAP_KEY" />

        <!-- 高德定位 SDK 的后台服务 -->
        <service android:name="com.amap.api.location.APSService" />

        <!-- 轨迹记录前台服务：Android 14+ 必须声明 foregroundServiceType -->
        <service
            android:name=".track.TrackRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- GPX 文件分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- App 入口 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自定义扫码页（带返回按钮） -->
        <activity
            android:name=".ui.components.ScanCaptureActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme" />
    </application>

</manifest>
